# Public browser configuration. Use the Supabase project URL and publishable/anon key.
# Never put a service-role key or SMTP password in NEXT_PUBLIC_* variables.
# Set both values in Vercel Production and trusted Preview environments, then rebuild.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
